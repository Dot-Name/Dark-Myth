NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
CLIENT_URL=http://localhost:5173
CROSS_SITE_COOKIES=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h

# Initial admin seed only. Remove these after creating the first account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required for catalogue cover/gallery images and protected PDF downloads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

MAX_IMAGE_MB=5
MAX_PDF_MB=50
DOWNLOAD_URL_TTL_SECONDS=120
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_MAX=5
